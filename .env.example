# ==============================================================================
# Antigravity Server / Gemini API - Configurações de Ambiente
# ==============================================================================

NODE_ENV=development
DOMAIN=gemini.seudominio.com
PUBLIC_BASE_URL=https://gemini.seudominio.com
HOST=0.0.0.0
PORT=3000
NUMIA_SERVER_TOKEN=troque-por-um-token-aleatorio-com-pelo-menos-32-caracteres
ALLOWED_ORIGINS=https://seu-app-ou-painel.example
ALLOWED_MODELS=
DEFAULT_MODEL=gemini-3.8-flash-high

# Para imagens, use o Flash rápido por padrão mesmo quando o chat estiver no Pro.
# Deixe vazio somente se quiser que imagens sigam o modelo escolhido no chat.
VISION_MODEL=gemini-3.7-flash-high

# Intervalos de manutenção de catálogo e CLI
MODEL_REFRESH_INTERVAL_MS=900000
CLI_COMMAND_REFRESH_INTERVAL_MS=900000
AGY_AUTO_UPDATE=true
AGY_UPDATE_INTERVAL_MS=21600000

# Fila e controle de concorrência (1 GB de RAM: mantenha 1)
MAX_GEMINI_PROCESSES=1
MAX_QUEUE_DEPTH=50
QUEUE_WAIT_TIMEOUT_MS=60000
AGY_TIMEOUT_MS=300000
AGY_COMMAND=agy

# MCP (Model Context Protocol) e Workspaces
MCP_ENABLED=true
MCP_WORKSPACES_DIR=/workspaces
MCP_WORKER_URL=http://workspace-worker:3010
MCP_WORKER_TOKEN=troque-por-outro-token-aleatorio-com-pelo-menos-32-caracteres
MCP_WORKER_ISOLATION=compat
MCP_COMMAND_TIMEOUT_MS=60000
SKILL_CATALOG_DIR=/app/skill-catalog
MCP_AUTO_INSTALL_SKILLS=true

# Diretório persistente de dados
DATA_DIR=/data

# Limites de upload e anexos
MAX_UPLOAD_BYTES=26214400
MAX_FILES_PER_UPLOAD=8
MAX_HISTORY_CHARS=120000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
TRUST_PROXY=true
REQUIRE_HTTPS=true

# Assinatura de Artefatos
ARTIFACT_SIGNING_KEY=chave-secreta-para-assinatura-de-urls-de-artefatos

# ==============================================================================
# StorageGuardian - Política de Retenção e Limpeza Automática (24 Horas)
# ==============================================================================
# Todos os arquivos temporários, gerados (PDF/DOCX/XLSX/etc), uploads e workspaces
# descartáveis permanecem no servidor por no máximo 24 horas e depois são apagados.
# Não há sistema de "pin" ou guardar permanente; arquivos gerados são descartáveis.
STORAGE_GUARDIAN_ENABLED=true
STORAGE_CHECK_INTERVAL_MINUTES=15
STORAGE_WARN_PERCENT=75
STORAGE_CLEANUP_PERCENT=85
STORAGE_AGGRESSIVE_PERCENT=90
STORAGE_CRITICAL_PERCENT=95
STORAGE_HARD_STOP_PERCENT=98
STORAGE_MIN_FREE_BYTES=5368709120

# Retenção padrão (em horas)
FILE_RETENTION_HOURS=24
ARTIFACT_RETENTION_HOURS=24
TEMP_WORKSPACE_RETENTION_HOURS=24
TRASH_RETENTION_HOURS=24

# Limites de capacidade de armazenamento
MAX_ARTIFACT_BYTES=104857600
MAX_TOTAL_ARTIFACT_BYTES=5368709120
MAX_WORKSPACE_BYTES=524288000
